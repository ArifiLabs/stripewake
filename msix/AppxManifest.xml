<?xml version="1.0" encoding="utf-8"?>
<!-- Stripewake Store (MSIX) package. Identity = Partner Center product 9P78PWTNFWQP; Microsoft signs it after certification.
     build-msix.cmd stamps nothing: change Version here for each Store submission. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity Name="ArifiLabs.Stripewake"
            Publisher="CN=7AD4276B-CEFA-488F-9B21-A064CB8C7597"
            Version="1.0.0.0"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Stripewake</DisplayName>
    <PublisherDisplayName>Arifi Labs</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Keeps Windows awake from the tray: no sleep, no screen off, no lock, for as long as you choose.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Stripewake" Executable="Stripewake.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Stripewake"
        Description="Keeps Windows awake from the tray."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="Stripewake" />
      </uap:VisualElements>
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="Stripewake.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="StripewakeStartup" Enabled="true" DisplayName="Stripewake" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
